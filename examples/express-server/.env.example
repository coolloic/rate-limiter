# Copy to .env (gitignored) to override. Variables already set in the environment win over .env.

# TCP port the example server listens on (0-65535; 0 lets the OS pick a free port, shown in the startup log).
# Default: 3000.
PORT=3000

# Requests each consumer may make per window (positive integer). Default: 10.
RATE_LIMIT_MAX_REQUESTS=10

# Sliding window length in milliseconds (positive integer). Default: 1000.
RATE_LIMIT_WINDOW_MS=1000

# Per-resource / per-consumer rules as JSON, on top of the default policy above. Most specific wins:
# overrides[resource][consumer] -> consumers[consumer] -> resources[resource] -> default.
# Each policy is {"limit": <positive integer>, "windowMs": <positive integer>}; every section is optional.
# Default (when unset or empty): /api/search 3 per 1000 ms, consumer partner-acme 50 per 1000 ms,
# and partner-acme on /api/search 20 per 1000 ms, i.e.:
# RATE_LIMIT_POLICIES={"resources":{"search":{"limit":3,"windowMs":1000}},"consumers":{"partner-acme":{"limit":50,"windowMs":1000}},"overrides":{"search":{"partner-acme":{"limit":20,"windowMs":1000}}}}

# /api/report calls an upstream service limited to UPSTREAM_RATE_LIMIT_MAX_REQUESTS calls per
# UPSTREAM_RATE_LIMIT_WINDOW_MS for the whole server (positive integers). Defaults: 5 per 1000 ms.
UPSTREAM_RATE_LIMIT_MAX_REQUESTS=5
UPSTREAM_RATE_LIMIT_WINDOW_MS=1000

# Longest a request waits for an upstream slot before answering 503 (positive integer, ms). Default: 2000.
UPSTREAM_MAX_WAIT_MS=2000
